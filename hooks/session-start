#!/usr/bin/env bash
# SessionStart hook for the handoff plugin.
# Fires on compact and resume. Silent unless a handoff is active, in which
# case it re-injects the charter so the agent continues in proxy mode
# instead of falling back to superpowers' normal human gates.

set -euo pipefail

project_dir="${CLAUDE_PROJECT_DIR:-$PWD}"
marker="${project_dir}/.claude/handoff.active"

if [ ! -f "$marker" ]; then
  exit 0
fi

charter=$(cat "$marker" 2>/dev/null || true)

escape_for_json() {
    local s="$1"
    s="${s//\/\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\n}"
    s="${s//$'\r'/\r}"
    s="${s//$'\t'/\t}"
    printf '%s' "$s"
}

charter_escaped=$(escape_for_json "$charter")
context="<HANDOFF_ACTIVE>\nA /handoff is in progress and the human is not in the room. Context was just compacted or resumed. Before doing anything else: invoke the handoff skill with the Skill tool, read its references/rulings.md, then read the decision log named in the charter below and continue from Current step. Superpowers gates are answered by rulings, not by asking the human, until the task ends or the user sends a message.\n\n${charter_escaped}\n</HANDOFF_ACTIVE>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
exit 0
